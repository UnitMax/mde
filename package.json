{
  "name": "mde",
  "version": "0.0.92",
  "description": "Agentic dev environment — grouped terminal sessions with first-class WSL support",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/UnitMax/mde",
  "author": {
    "name": "UnitMax",
    "email": "105129888+UnitMax@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "compile": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:package": "node scripts/audit-packaged-output.mjs",
    "audit:deps": "npm audit",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "build": "npm run licenses:check && npm run typecheck && electron-vite build && electron-builder && npm run audit:package",
    "build:win": "npm run licenses:check && npm run typecheck && electron-vite build && electron-builder --win && npm run audit:package",
    "build:linux": "npm run licenses:check && npm run typecheck && electron-vite build && electron-builder --linux && npm run audit:package",
    "build:win:remote": "bash scripts/build-windows.sh",
    "postinstall": "node scripts/install-node-pty.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron/rebuild": "4.2.0",
    "@lezer/highlight": "1.2.4",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/markdown": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "43.7.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
